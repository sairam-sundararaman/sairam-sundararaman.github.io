---
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const { current = '/' } = Astro.props;
const items = [
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const active = (href: string) => current.startsWith(href.slice(0, -1));
---
<header class="top">
  <div class="wrap bar">
    <a class="brand" href="/"><Mark /><span>{site.name}</span></a>
    <nav class="menu label" aria-label="Primary">
      {items.map((i) => <a href={i.href} aria-current={active(i.href) ? 'page' : undefined}>{i.label}</a>)}
      <ThemeToggle />
    </nav>
  </div>
</header>
