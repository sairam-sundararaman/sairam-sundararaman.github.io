<button type="button" class="toggle" id="theme-toggle" aria-label="Switch colour theme">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8" />
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" />
  </svg>
</button>
<script is:inline>
  (function () {
    var b = document.getElementById('theme-toggle');
    if (!b) return;
    var mq = matchMedia('(prefers-color-scheme: dark)');
    function eff() { return document.documentElement.dataset.theme || (mq.matches ? 'dark' : 'light'); }
    function label() { b.setAttribute('aria-label', 'Switch to ' + (eff() === 'dark' ? 'light' : 'dark') + ' theme'); }
    label();
    mq.addEventListener('change', label);
    b.addEventListener('click', function () {
      var n = eff() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = n;
      try { localStorage.setItem('theme', n); } catch (e) {}
      label();
    });
  })();
</script>
